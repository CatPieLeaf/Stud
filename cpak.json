{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Stud",
  "description": "An Unofficial Open-Source Roblox Launcher for Linux",
  "version": "1.2.8",
  "image": "ghcr.io/catpieleaf/stud@sha256:9370bb3869c8c0f04c818cc42d4c1efef47088ce3350df0c740c4cd7eaf38390",
  "binaries": [
    "/usr/bin/stud"
  ],
  "desktop_entries": [
    "/usr/share/applications/io.github.catpieleaf.Stud.desktop"
  ],
  "form_factors": [
    "desktop"
  ],
  "services": {},
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketWayland": true,
    "socketPulseAudio": true,
    "deviceDri": true,
    "deviceShm": true,
    "notification": true,
    "openURI": true,
    "network": true,
    "userNamespaces": true,
    "filePicker": {
      "openFile": true,
      "persistent": true
    },
    "filesystem": [
      {
        "path": "xdg-download",
        "access": "read-only"
      },
      {
        "path": "home/.config/kdeglobals",
        "access": "read-only"
      }
    ],
    "sessionBus": {
      "talk": [
        {
          "name": "org.kde.kwalletd6",
          "path": "/modules/kwalletd6",
          "interface": "org.kde.KWallet",
          "members": [
            "close",
            "createFolder",
            "entryType",
            "hasEntry",
            "hasFolder",
            "networkWallet",
            "open",
            "readEntry",
            "readPassword",
            "removeEntry",
            "writeEntry",
            "writePassword"
          ]
        },
        {
          "name": "org.kde.StatusNotifierWatcher",
          "path": "/StatusNotifierWatcher",
          "interface": "org.kde.StatusNotifierWatcher",
          "members": [
            "RegisterStatusNotifierItem",
            "RegisterStatusNotifierHost"
          ]
        },
        {
          "name": "org.kde.StatusNotifierWatcher",
          "path": "/StatusNotifierWatcher",
          "interface": "org.freedesktop.DBus.Properties",
          "members": [
            "Get",
            "GetAll",
            "PropertiesChanged"
          ]
        },
        {
          "name": "org.freedesktop.Notifications",
          "path": "/org/freedesktop/Notifications",
          "interface": "org.freedesktop.Notifications",
          "members": [
            "Notify"
          ]
        }
      ],
      "own": [
        "org.kde.StatusNotifierItem-"
      ]
    }
  }
}
