{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Stud",
  "description": "Play Roblox on Linux.",
  "version": "1.1.0",
  "image": "ghcr.io/catpieleaf/stud@sha256:7276b61fc041081c0f88628e912c351d5a00cf39723e30a26010544edd652b7b",
  "binaries": [
    "/usr/bin/stud"
  ],
  "desktop_entries": [
    "/usr/share/applications/io.github.catpieleaf.Stud.desktop"
  ],
  "form_factors": [
    "desktop"
  ],
  "services": {},
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketWayland": true,
    "socketPulseAudio": true,
    "deviceDri": true,
    "deviceShm": true,
    "notification": true,
    "openURI": true,
    "network": true,
    "userNamespaces": true,
    "filePicker": {
      "openFile": true,
      "persistent": true
    },
    "filesystem": [
      {
        "path": "xdg-download",
        "access": "read-only"
      }
    ],
    "sessionBus": {
      "talk": [
        {
          "name": "org.kde.kwalletd6",
          "path": "/modules/kwalletd6",
          "interface": "org.kde.KWallet",
          "members": [
            "open",
            "close",
            "hasEntry",
            "readEntry",
            "writeEntry",
            "removeEntry",
            "createFolder",
            "hasFolder",
            "networkWallet"
          ]
        }
      ]
    }
  }
}
