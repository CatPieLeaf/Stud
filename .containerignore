# Keeps a container build's context to what a build actually reads.
#
# third_party/ is deliberately NOT excluded: the NDK, ANGLE and bionic
# are what Stud is built against, and an image build without them
# silently produces no Process B.
build/
build-*/
.git/
*.AppImage
*.rpm
*.deb
third_party/appimage-tools/

# Packaging staging directories and bundles, for the same reason.
#
# install-tree/ is deliberately NOT excluded: it is what
# packaging/cpak/Containerfile.prebuilt copies its whole /usr from, so
# excluding it does not trim the context, it breaks the image build
# ("no items matching glob install-tree"). Any exclusion here applies to
# every build from this context, not only the one it was written for.
deb-tree/
*.pkg.tar.zst
*.flatpak
