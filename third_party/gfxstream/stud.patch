+// Forgets (and frees) the hidden renderbuffers of `fbo`, for `attachment` or
+// all of them (0).
+static void sMsrttDrop(GLESv2Context* ctx, GLuint fbo, GLenum attachment) {
+    if (!fbo) return;
+    std::vector<GLuint> freed;
+    {
+        std::lock_guard<std::mutex> lock(s_msrttLock);
+        auto it = s_msrtt.find({ctx, fbo});
+        if (it == s_msrtt.end()) return;
+        auto& list = it->second;
+        for (auto r = list.begin(); r != list.end();) {
+            if (attachment && r->attachment != attachment) {
+                ++r;
+                continue;
+            }
+            freed.push_back(r->renderbuffer);
+            r = list.erase(r);
+        }
+        if (list.empty()) s_msrtt.erase(it);
+    }
+    if (!freed.empty()) {
+        ctx->dispatcher().glDeleteRenderbuffers(static_cast<GLsizei>(freed.size()), freed.data());
