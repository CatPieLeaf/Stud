+// Resolves `fbo`'s multisampled attachments into their textures.
+static void sMsrttResolve(GLESv2Context* ctx, GLuint fbo) {
+    std::vector<StudMsrtt> list;
+    {
+        std::lock_guard<std::mutex> lock(s_msrttLock);
+        auto it = s_msrtt.find({ctx, fbo});
+        if (it == s_msrtt.end()) return;
+        list = it->second;
+    }
+    auto& gl = ctx->dispatcher();
+    GLint prevRead = 0, prevDraw = 0, prevReadBuffer = GL_COLOR_ATTACHMENT0;
+    gl.glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevRead);
+    gl.glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &prevDraw);
+    // A blit is clipped by the scissor test; a resolve is of the whole image.
+    const GLboolean scissor = gl.glIsEnabled(GL_SCISSOR_TEST);
+    if (scissor) gl.glDisable(GL_SCISSOR_TEST);
+    gl.glBindFramebuffer(GL_READ_FRAMEBUFFER, ctx->getFBOGlobalName(fbo));
+    gl.glGetIntegerv(GL_READ_BUFFER, &prevReadBuffer);
+    GLuint resolve = 0;
+    gl.glGenFramebuffers(1, &resolve);
+    gl.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, resolve);
+    bool twins = false;
+    for (const StudMsrtt& r : list) {
+        if (r.msTexture) {
+            twins = true;
+            continue;
+        }
+        gl.glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, r.attachment, r.textarget, r.texture, r.level);
+        GLbitfield mask = 0;
+        if (r.attachment == GL_DEPTH_ATTACHMENT) {
+            mask = GL_DEPTH_BUFFER_BIT;
+        } else if (r.attachment == GL_STENCIL_ATTACHMENT) {
+            mask = GL_STENCIL_BUFFER_BIT;
+        } else if (r.attachment == GL_DEPTH_STENCIL_ATTACHMENT) {
+            mask = GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT;
+        } else {
+            mask = GL_COLOR_BUFFER_BIT;
+            gl.glReadBuffer(r.attachment);
+            const GLenum drawBuffer = r.attachment;
+            gl.glDrawBuffers(1, &drawBuffer);
+        }
+        gl.glBlitFramebuffer(0, 0, r.width, r.height, 0, 0, r.width, r.height, mask, GL_NEAREST);
+        gl.glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, r.attachment, r.textarget, 0, 0);
+    }
+    gl.glReadBuffer(prevReadBuffer);
+    gl.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, prevDraw);
+    gl.glBindFramebuffer(GL_READ_FRAMEBUFFER, prevRead);
+    gl.glDeleteFramebuffers(1, &resolve);
+    if (scissor) gl.glEnable(GL_SCISSOR_TEST);
+    if (twins) sMsTwinResolve(ctx, list);
+}
