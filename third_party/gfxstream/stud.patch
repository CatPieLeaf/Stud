+// GL_EXT_multisampled_render_to_texture: the texture is attached as by
+// glFramebufferTexture2D, and counts as having `samples` samples when the
+// framebuffer's completeness is checked; the host renders it multisampled
+// and resolves it into the texture.
+void GL2Encoder::s_glFramebufferTexture2DMultisampleEXT(void* self,
+        GLenum target, GLenum attachment,
+        GLenum textarget, GLuint texture, GLint level, GLsizei samples) {
+    GL2Encoder* ctx = (GL2Encoder*)self;
+    GLClientState* state = ctx->m_state;
+
+    SET_ERROR_IF(!GLESv2Validation::framebufferTarget(ctx, target), GL_INVALID_ENUM);
+    SET_ERROR_IF(textarget != GL_TEXTURE_2D, GL_INVALID_ENUM);
+    SET_ERROR_IF(!GLESv2Validation::framebufferAttachment(ctx, attachment), GL_INVALID_ENUM);
+    SET_ERROR_IF(!state->getBoundFramebuffer(target), GL_INVALID_OPERATION);
+    SET_ERROR_IF(texture && !state->isTexture(texture), GL_INVALID_OPERATION);
+    SET_ERROR_IF(level != 0 || samples < 0, GL_INVALID_VALUE);
+
+    state->attachTextureObject(target, attachment, texture, level, 0);
+    if (texture && samples) state->setFboAttachmentSamples(target, attachment, samples);
+
+    ctx->m_glFramebufferTexture2DMultisampleEXT_enc(self, target, attachment, textarget, texture,
+                                                    level, samples);
+}
+
+// A renderbuffer's implicit resolve has nothing to resolve into: the same as
+// glRenderbufferStorageMultisample.
+void GL2Encoder::s_glRenderbufferStorageMultisampleEXT(void* self, GLenum target, GLsizei samples,
+                                                       GLenum internalformat, GLsizei width,
+                                                       GLsizei height) {
+    s_glRenderbufferStorageMultisample(self, target, samples, internalformat, width, height);
+}
+
 void GL2Encoder::s_glFramebufferTexture3DOES(void* self,
         GLenum target, GLenum attachment,
         GLenum textarget, GLuint texture, GLint level, GLint zoffset) {
@@ -3312,6 +3346,25 @@ GLenum GL2Encoder::s_glCheckFramebufferStatus(void* self, GLenum target) {
 
     GLClientState* state = ctx->m_state;
 
+    // An app that cannot allocate multisample textures (it never calls
+    // glTexStorage2DMultisample) may still attach them, unallocated, to its
+    // multisampled framebuffers. Each is given storage here, at the sample
+    // count and size of the framebuffer's multisampled attachments, so the
+    // framebuffer is complete.
+    GLuint tex = 0;
+    GLsizei samples = 0, width = 0, height = 0;
+    GLint format = 0;
+    while (state->unallocatedMultisampleAttachment(
+            target, [ctx](GLint f) { return GLESv2Validation::depthRenderableFormat(ctx, f); },
+            &tex, &samples, &format, &width, &height)) {
+        const GLuint previous = state->getBoundTexture(GL_TEXTURE_2D_MULTISAMPLE);
+        ctx->glBindTexture(ctx, GL_TEXTURE_2D_MULTISAMPLE, tex);
+        ctx->glTexStorage2DMultisample(ctx, GL_TEXTURE_2D_MULTISAMPLE, samples, format, width,
+                                       height, GL_TRUE);
+        ctx->glBindTexture(ctx, GL_TEXTURE_2D_MULTISAMPLE, previous);
+        if (!state->isTextureWithStorage(tex)) break;  // refused: leave the rest as the app made it
+    }
+
     return state->checkFramebufferCompleteness(target);
 }
 
