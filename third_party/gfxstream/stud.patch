+
+// The app's texture `ms` (the driver's name) is going: so is its twin, and
+// every resolve into it.
+static void sMsTwinForget(GLESv2Context* ctx, GLuint ms) {
+    StudMsTwin twin{};
+    if (!ms || !sMsTwinOf(ms, &twin)) return;
+    {
+        std::lock_guard<std::mutex> lock(s_msTwinLock);
+        s_msTwins.erase(ms);
+    }
+    {
+        std::lock_guard<std::mutex> lock(s_msrttLock);
+        for (auto it = s_msrtt.begin(); it != s_msrtt.end();) {
+            auto& list = it->second;
+            for (auto r = list.begin(); r != list.end();) {
+                r = r->texture == twin.twin ? list.erase(r) : r + 1;
+            }
+            it = list.empty() ? s_msrtt.erase(it) : std::next(it);
+        }
+    }
+    ctx->dispatcher().glDeleteTextures(1, &twin.twin);
+}
