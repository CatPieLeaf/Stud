+// Twins, per context: the program that copies sample 0 of a multisample
+// texture, and the vertex array its draw runs with.
+namespace {
+struct StudSampleCopy {
+    GLuint program = 0;
+    GLuint vao = 0;
+};
+std::mutex s_sampleCopyLock;
+std::map<const void*, StudSampleCopy> s_sampleCopy;
+}  // namespace
+
+static StudSampleCopy sSampleCopyProgram(GLESv2Context* ctx) {
+    {
+        std::lock_guard<std::mutex> lock(s_sampleCopyLock);
+        auto it = s_sampleCopy.find(ctx);
+        if (it != s_sampleCopy.end()) return it->second;
+    }
+    auto& gl = ctx->dispatcher();
+    static const char* kVertex =
+            "#version 310 es\n"
+            "void main() {\n"
+            "    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));\n"
+            "    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+            "}\n";
+    static const char* kFragment =
+            "#version 310 es\n"
+            "precision highp float;\n"
+            "uniform highp sampler2DMS source;\n"
+            "layout(location = 0) out vec4 color;\n"
+            "void main() { color = texelFetch(source, ivec2(gl_FragCoord.xy), 0); }\n";
+    StudSampleCopy copy;
+    const GLuint vs = gl.glCreateShader(GL_VERTEX_SHADER);
+    const GLuint fs = gl.glCreateShader(GL_FRAGMENT_SHADER);
+    gl.glShaderSource(vs, 1, &kVertex, nullptr);
+    gl.glShaderSource(fs, 1, &kFragment, nullptr);
+    gl.glCompileShader(vs);
+    gl.glCompileShader(fs);
+    copy.program = gl.glCreateProgram();
+    gl.glAttachShader(copy.program, vs);
+    gl.glAttachShader(copy.program, fs);
+    gl.glLinkProgram(copy.program);
+    gl.glDeleteShader(vs);
+    gl.glDeleteShader(fs);
+    GLint linked = GL_FALSE;
+    gl.glGetProgramiv(copy.program, GL_LINK_STATUS, &linked);
+    if (!linked) {
+        gl.glDeleteProgram(copy.program);
+        copy.program = 0;
+    } else {
+        GLint previous = 0;
+        gl.glGetIntegerv(GL_CURRENT_PROGRAM, &previous);
+        gl.glUseProgram(copy.program);
+        gl.glUniform1i(gl.glGetUniformLocation(copy.program, "source"), 0);
+        gl.glUseProgram(previous);
+        gl.glGenVertexArrays(1, &copy.vao);
+    }
+    std::lock_guard<std::mutex> lock(s_sampleCopyLock);
+    s_sampleCopy[ctx] = copy;
+    return copy;
+}
+
+// Fills each twin in `list` with sample 0 of its multisample texture: the
+// value one sample holds, as a single-sample render target would, where a
+// blit's resolve averages the samples (an id or index stored per pixel
+// becomes one that belongs to nothing). The app's GL state is left as found.
+static void sMsTwinResolve(GLESv2Context* ctx, const std::vector<StudMsrtt>& list) {
+    const StudSampleCopy copy = sSampleCopyProgram(ctx);
+    if (!copy.program) return;
+    auto& gl = ctx->dispatcher();
+    GLint program = 0, vao = 0, drawFbo = 0, activeTexture = GL_TEXTURE0, msBinding = 0;
+    GLint viewport[4] = {};
+    GLboolean colorMask[4] = {};
+    gl.glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+    gl.glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+    gl.glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &drawFbo);
+    gl.glGetIntegerv(GL_ACTIVE_TEXTURE, &activeTexture);
+    gl.glGetIntegerv(GL_VIEWPORT, viewport);
+    gl.glGetBooleanv(GL_COLOR_WRITEMASK, colorMask);
+    static const GLenum kCaps[] = {GL_SCISSOR_TEST, GL_BLEND,          GL_DEPTH_TEST,
+                                   GL_STENCIL_TEST, GL_CULL_FACE,      GL_RASTERIZER_DISCARD,
+                                   GL_SAMPLE_MASK,  GL_POLYGON_OFFSET_FILL};
+    GLboolean enabled[sizeof(kCaps) / sizeof(kCaps[0])];
+    for (size_t i = 0; i < sizeof(kCaps) / sizeof(kCaps[0]); ++i) {
+        enabled[i] = gl.glIsEnabled(kCaps[i]);
+        if (enabled[i]) gl.glDisable(kCaps[i]);
+    }
+    gl.glActiveTexture(GL_TEXTURE0);
+    gl.glGetIntegerv(GL_TEXTURE_BINDING_2D_MULTISAMPLE, &msBinding);
+    gl.glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    gl.glUseProgram(copy.program);
+    gl.glBindVertexArray(copy.vao);
+
+    GLuint target = 0;
+    gl.glGenFramebuffers(1, &target);
+    gl.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, target);
+    for (const StudMsrtt& r : list) {
+        if (!r.msTexture) continue;
+        gl.glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, r.textarget, r.texture,
+                                  r.level);
+        gl.glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, r.msTexture);
+        gl.glViewport(0, 0, r.width, r.height);
+        gl.glDrawArrays(GL_TRIANGLES, 0, 3);
+    }
+    gl.glDeleteFramebuffers(1, &target);
+
+    gl.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, drawFbo);
+    gl.glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, msBinding);
+    gl.glActiveTexture(activeTexture);
+    gl.glBindVertexArray(vao);
+    gl.glUseProgram(program);
+    gl.glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+    gl.glColorMask(colorMask[0], colorMask[1], colorMask[2], colorMask[3]);
+    for (size_t i = 0; i < sizeof(kCaps) / sizeof(kCaps[0]); ++i) {
+        if (enabled[i]) gl.glEnable(kCaps[i]);
+    }
+}
