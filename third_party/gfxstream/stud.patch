+// fences the end of each frame where the guest flushes it, the embedder's
+// presenter has the GPU wait on that fence before drawing the colour buffer,
+// and fences its own draw for the guest's next frame into the same colour
+// buffer to wait on. No CPU waits on the GPU anywhere.
+
+namespace {
+
+struct StudFrame {
+    uint64_t flushed = 0;
+    uint64_t presented = 0;
+    GLsync done = nullptr;   // end of the guest's latest frame into it
+    GLsync shown = nullptr;  // end of the presenter's draw from it
+};
+std::mutex s_framesLock;
+std::condition_variable s_framesChanged;
+// ponytail: entries outlive their colour buffer (two fence slots each);
+// erase on rcCloseColorBuffer if a long session ever churns windows.
+std::map<uint32_t, StudFrame> s_frames;
+
+GLsync studFence() {
+    if (!GLEScontext::dispatcher().glFenceSync) return nullptr;
+    GLsync f = GLEScontext::dispatcher().glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    // Flushed, so a wait in another context can see it signal.
+    GLEScontext::dispatcher().glFlush();
+    return f;
+}
+
+void studGpuWait(GLsync f) {
+    if (!f) return;
+    GLEScontext::dispatcher().glWaitSync(f, 0, GL_TIMEOUT_IGNORED);
+    GLEScontext::dispatcher().glDeleteSync(f);
+}
+
+}  // namespace
+
+// The guest has flushed a frame into `colorBuffer` (its render thread, its
+// context current).
+extern "C" void gfxstream_stud_frame_flushed(uint32_t colorBuffer) {
+    GLsync f = studFence();
+    std::lock_guard<std::mutex> lock(s_framesLock);
+    StudFrame& frame = s_frames[colorBuffer];
+    if (frame.done) GLEScontext::dispatcher().glDeleteSync(frame.done);
+    frame.done = f;
+    ++frame.flushed;
+    s_framesChanged.notify_all();
+}
+
+// The guest is about to render into `colorBuffer` again: its later
+// commands wait on the GPU for the presenter's draw from it.
+extern "C" void gfxstream_stud_before_reuse(uint32_t colorBuffer) {
+    GLsync f = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(s_framesLock);
+        auto it = s_frames.find(colorBuffer);
+        if (it == s_frames.end()) return;
+        f = it->second.shown;
+        it->second.shown = nullptr;
+    }
+    studGpuWait(f);
+}
+
+// For the embedder's presenter, its context current: waits until the guest's
+// frame into `colorBuffer` has been flushed on the host (the decode of the
+// guest's commands, not the GPU), then has the GPU wait for it.
+extern "C" void gfxstream_wait_frame(uint32_t colorBuffer) {
+    GLsync f = nullptr;
+    {
+        std::unique_lock<std::mutex> lock(s_framesLock);
+        StudFrame& frame = s_frames[colorBuffer];
+        s_framesChanged.wait(lock, [&] { return frame.flushed > frame.presented; });
+        f = frame.done;
+        frame.done = nullptr;
+        frame.presented = frame.flushed;
+    }
+    studGpuWait(f);
+}
+
+// For the presenter, after drawing from `colorBuffer`.
+extern "C" void gfxstream_frame_shown(uint32_t colorBuffer) {
+    GLsync f = studFence();
+    std::lock_guard<std::mutex> lock(s_framesLock);
+    StudFrame& frame = s_frames[colorBuffer];
+    if (frame.shown) GLEScontext::dispatcher().glDeleteSync(frame.shown);
+    frame.shown = f;
+}
