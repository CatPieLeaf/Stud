+// A multisample colour texture's single-sample twin. An app whose shaders read
+// textures only through sampler2D (it has no multisample textures of its own;
+// the guest gives an unallocated one storage to complete its framebuffer)
+// still binds the multisample texture where it reads the rendered image: the
+// twin holds that image, resolved, and is what such a read sees.
+struct StudMsTwin {
+    GLuint twin;  // the driver's
+    GLsizei width;
+    GLsizei height;
+};
+std::mutex s_msTwinLock;
+std::map<GLuint, StudMsTwin> s_msTwins;                  // driver's multisample texture -> twin
+std::set<std::pair<const void*, unsigned int>> s_unitShowsTwin;  // (context, unit)
+}  // namespace
+
+// The twin of the multisample colour texture bound to GL_TEXTURE_2D_MULTISAMPLE,
+// just given storage.
+static void sMsTwinCreate(GLESv2Context* ctx, GLenum internalformat, GLsizei width, GLsizei height) {
+    const GLuint ms = ctx->shareGroup()->getGlobalName(
+            NamedObjectType::TEXTURE,
+            ctx->getTextureLocalName(GL_TEXTURE_2D_MULTISAMPLE,
+                                     ctx->getBindedTexture(GL_TEXTURE_2D_MULTISAMPLE)));
+    if (!ms) return;
+    auto& gl = ctx->dispatcher();
+    GLint previous = 0;
+    gl.glGetIntegerv(GL_TEXTURE_BINDING_2D, &previous);
+    GLuint twin = 0;
+    gl.glGenTextures(1, &twin);
+    gl.glBindTexture(GL_TEXTURE_2D, twin);
+    gl.glTexStorage2D(GL_TEXTURE_2D, 1, internalformat, width, height);
+    // Read as the multisample texture is: texel by texel, with no filtering
+    // between texels (which would blend the ids an app stores per pixel) and
+    // nothing beyond its edges.
+    gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    gl.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    gl.glBindTexture(GL_TEXTURE_2D, previous);
