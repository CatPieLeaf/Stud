+                        props.stencilAttachment_hasRbo ? props.stencilAttachment_rbo : nullptr, true});
+    attached.push_back({props.depthstencilAttachment_hasTexObj ? props.depthstencilAttachment_texture : nullptr,
+                        props.depthstencilAttachment_hasRbo ? props.depthstencilAttachment_rbo : nullptr, true});
