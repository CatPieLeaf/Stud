+// The engine bakes its UI gradients into GradientAtlasTexture with the same
+// y-flipped projection it draws the window with, so on GL (origin lower left)
+// its gradient row k lands on texture row H-1-k; its shaders then read row k,
+// v = CB2[2].x, the top-left convention it renders in on Vulkan. That row
+// holds only the atlas's clear colour, so every UIGradient element came out
+// with alpha 0. Each read of the atlas, texture(GradientAtlasTexture,
+// vec2(u, v)), reads v as 1 - v: the row the bake wrote.
+static std::string flipGradientAtlasRow(const std::string& src) {
+    static const std::string kRead = "texture(GradientAtlasTexture, vec2(";
+    if (src.find(kRead) == std::string::npos) return src;
+    std::string out;
+    size_t from = 0;
+    for (size_t at; (at = src.find(kRead, from)) != std::string::npos;) {
+        const size_t args = at + kRead.size();
+        // The vec2's two arguments: the comma and the closing parenthesis at
+        // its own nesting depth.
+        size_t comma = std::string::npos, close = std::string::npos;
+        int depth = 0;
+        for (size_t i = args; i < src.size() && close == std::string::npos; ++i) {
+            if (src[i] == '(') ++depth;
+            else if (src[i] == ')' && depth-- == 0) close = i;
+            else if (src[i] == ',' && depth == 0) comma = i;
+        }
+        if (comma == std::string::npos || close == std::string::npos) break;
+        size_t v = comma + 1;
+        while (v < close && src[v] == ' ') ++v;
+        out.append(src, from, comma + 1 - from);
+        out += " 1.0 - (";
+        out.append(src, v, close - v);
+        out += ")";
+        from = close;
+    }
+    out.append(src, from, std::string::npos);
+    return out;
+}
