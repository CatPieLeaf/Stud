+// GL_EXT_multisampled_render_to_texture, which mobile drivers have and
+// desktop ones mostly lack: a texture attached with a sample count renders
+// multisampled and is resolved into the texture. Here the driver gets a
+// hidden multisampled renderbuffer of the texture's own format and size in
+// its place (so every attachment has the same sample count, as GLES
+// requires), resolved into the texture by a blit when the app leaves the
+// framebuffer. Per context, by the app's framebuffer name.
+namespace {
+struct StudMsrtt {
+    GLenum attachment;
+    GLuint renderbuffer;  // the driver's, multisampled
+    GLuint texture;       // the driver's
+    GLenum textarget;
+    GLint level;
+    GLsizei width;
+    GLsizei height;
+    // For a twin: the driver's multisample texture it is the twin of.
+    GLuint msTexture = 0;
+};
+std::mutex s_msrttLock;
+std::map<std::pair<const void*, GLuint>, std::vector<StudMsrtt>> s_msrtt;
