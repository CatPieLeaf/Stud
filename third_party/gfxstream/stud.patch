+GL_APICALL void GL_APIENTRY glFramebufferTexture2DMultisampleEXT(GLenum target, GLenum attachment,
+                                                                 GLenum textarget, GLuint texture,
+                                                                 GLint level, GLsizei samples) {
+    GET_CTX_V2();
+    // The texture is attached as for glFramebufferTexture2D, so the app's
+    // records and the driver both have it; with a sample count, the driver's
+    // attachment is then a multisampled renderbuffer resolved into it.
+    glFramebufferTexture2D(target, attachment, textarget, texture, level);
+    SET_ERROR_IF(samples < 0, GL_INVALID_VALUE);
+    if (!samples || !texture || textarget != GL_TEXTURE_2D) return;
+    auto& gl = ctx->dispatcher();
+    GLint maxSamples = 0;
+    gl.glGetIntegerv(GL_MAX_SAMPLES, &maxSamples);
+    SET_ERROR_IF(samples > maxSamples, GL_INVALID_VALUE);
+
+    // The texture's own format and size, as the driver holds them.
+    const GLuint globalTexture = ctx->shareGroup()->getGlobalName(
+            NamedObjectType::TEXTURE, ctx->getTextureLocalName(textarget, texture));
+    GLint prevTexture = 0, format = 0, width = 0, height = 0;
+    gl.glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTexture);
+    gl.glBindTexture(GL_TEXTURE_2D, globalTexture);
+    gl.glGetTexLevelParameteriv(GL_TEXTURE_2D, level, GL_TEXTURE_INTERNAL_FORMAT, &format);
+    gl.glGetTexLevelParameteriv(GL_TEXTURE_2D, level, GL_TEXTURE_WIDTH, &width);
+    gl.glGetTexLevelParameteriv(GL_TEXTURE_2D, level, GL_TEXTURE_HEIGHT, &height);
+    gl.glBindTexture(GL_TEXTURE_2D, prevTexture);
+    if (!format || !width || !height) return;
+
+    GLint prevRenderbuffer = 0;
+    GLuint renderbuffer = 0;
+    gl.glGetIntegerv(GL_RENDERBUFFER_BINDING, &prevRenderbuffer);
+    gl.glGenRenderbuffers(1, &renderbuffer);
+    gl.glBindRenderbuffer(GL_RENDERBUFFER, renderbuffer);
+    gl.glRenderbufferStorageMultisample(GL_RENDERBUFFER, samples, format, width, height);
+    gl.glBindRenderbuffer(GL_RENDERBUFFER, prevRenderbuffer);
+    gl.glFramebufferRenderbuffer(target, attachment, GL_RENDERBUFFER, renderbuffer);
+
+    std::lock_guard<std::mutex> lock(s_msrttLock);
+    s_msrtt[{ctx, ctx->getFramebufferBinding(target)}].push_back(
+            StudMsrtt{attachment, renderbuffer, globalTexture, textarget, level, width, height});
