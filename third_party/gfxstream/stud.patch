+    {
+        std::lock_guard<std::mutex> lock(s_msTwinLock);
+        auto it = s_msTwins.find(ms);
+        if (it != s_msTwins.end()) old = it->second.twin;
+        s_msTwins[ms] = StudMsTwin{twin, width, height};
+    }
+    if (old) gl.glDeleteTextures(1, &old);
+
+    // Storage comes after the attachment (the guest gives it while checking
+    // the framebuffer the texture is attached to): that framebuffer resolves
+    // into the twin from now on.
+    const GLuint fbo = ctx->getFramebufferBinding(GL_DRAW_FRAMEBUFFER);
+    if (!fbo) return;
+    GLint colorAttachments = 0;
+    gl.glGetIntegerv(GL_MAX_COLOR_ATTACHMENTS, &colorAttachments);
+    for (GLint i = 0; i < colorAttachments; ++i) {
+        const GLenum attachment = GL_COLOR_ATTACHMENT0 + i;
+        GLint type = GL_NONE, name = 0;
+        gl.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, attachment,
+                                                 GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &type);
+        if (type != GL_TEXTURE) continue;
+        gl.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, attachment,
+                                                 GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &name);
+        if (static_cast<GLuint>(name) != ms) continue;
+        std::lock_guard<std::mutex> lock(s_msrttLock);
+        s_msrtt[{ctx, fbo}].push_back(
+                StudMsrtt{attachment, 0, twin, GL_TEXTURE_2D, 0, width, height, ms});
+    }
+}
+
+static bool sMsTwinOf(GLuint ms, StudMsTwin* out) {
+    std::lock_guard<std::mutex> lock(s_msTwinLock);
+    auto it = s_msTwins.find(ms);
+    if (it == s_msTwins.end()) return false;
+    *out = it->second;
+    return true;
+}
+
+// After the app binds `ms` (the driver's name, 0 for none) to
+// GL_TEXTURE_2D_MULTISAMPLE on the active unit: the unit's 2D target shows
+// its twin, or again the app's own 2D texture.
+static void sMsTwinShow(GLESv2Context* ctx, GLuint ms) {
+    const auto key = std::make_pair(static_cast<const void*>(ctx), ctx->getActiveTextureUnit());
+    StudMsTwin twin{};
+    if (ms && sMsTwinOf(ms, &twin)) {
+        ctx->dispatcher().glBindTexture(GL_TEXTURE_2D, twin.twin);
+        std::lock_guard<std::mutex> lock(s_msTwinLock);
+        s_unitShowsTwin.insert(key);
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(s_msTwinLock);
+        if (!s_unitShowsTwin.erase(key)) return;
+    }
+    const GLuint override = GLESv2Context::unitTextureOverride(ctx->getActiveTextureUnit());
+    const GLuint own = ctx->shareGroup()->getGlobalName(
+            NamedObjectType::TEXTURE,
+            ctx->getTextureLocalName(GL_TEXTURE_2D, ctx->getBindedTexture(GL_TEXTURE_2D)));
+    ctx->dispatcher().glBindTexture(GL_TEXTURE_2D, override ? override : own);
