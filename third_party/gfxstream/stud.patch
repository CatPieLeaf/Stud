+// Applies the embedder's settings to this context, once per change to them;
+// afterwards glBindTexture keeps the texture ones in place.
+void GLESv2Context::applyEmbedderSettings() {
+    const uint64_t generation = s_unitOverrideGeneration.load();
+    if (m_embedderSettingsGeneration == generation) return;
+    m_embedderSettingsGeneration = generation;
+    if (s_clipControl) {
+        s_clipControl(0x8CA1 /* GL_LOWER_LEFT_EXT */,
+                      s_clipZeroToOne ? 0x935F /* GL_ZERO_TO_ONE_EXT */
+                                      : 0x935E /* GL_NEGATIVE_ONE_TO_ONE_EXT */);
+    }
+    std::map<unsigned int, GLuint> overrides;
+    {
+        std::lock_guard<std::mutex> lock(s_unitOverrideLock);
+        overrides = s_unitOverrides;
+    }
+    const unsigned int active = getActiveTextureUnit();
+    for (const auto& [unit, texture] : overrides) {
+        if (static_cast<int>(unit) >= getMaxCombinedTexUnits()) continue;
+        dispatcher().glActiveTexture(GL_TEXTURE0 + unit);
+        dispatcher().glBindTexture(GL_TEXTURE_2D, texture);
+    }
+    dispatcher().glActiveTexture(GL_TEXTURE0 + active);
+    applyCubeMirrors();
+}
+
+void GLESv2Context::applyCubeMirrors() {
+    std::map<unsigned int, unsigned int> mirrors;
+    {
+        std::lock_guard<std::mutex> lock(s_unitOverrideLock);
+        if (s_cubeMirrors.empty()) return;
+        mirrors = s_cubeMirrors;
+    }
+    const unsigned int active = getActiveTextureUnit();
+    for (const auto& [unit, source] : mirrors) {
+        if (static_cast<int>(std::max(unit, source)) >= getMaxCombinedTexUnits()) continue;
+        const unsigned int local = getBindedTexture(GL_TEXTURE0 + source, GL_TEXTURE_CUBE_MAP);
+        if (local == 0 || !shareGroup().get()) continue;
+        const GLuint global = shareGroup()->getGlobalName(NamedObjectType::TEXTURE, local);
+        if (global == 0) continue;
+        dispatcher().glActiveTexture(GL_TEXTURE0 + unit);
+        dispatcher().glBindTexture(GL_TEXTURE_CUBE_MAP, global);
+    }
+    dispatcher().glActiveTexture(GL_TEXTURE0 + active);
+}
