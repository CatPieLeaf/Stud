#version 450

// Lanczos-2, with anti-ringing.
//
// Like bicubic.comp this is written rather than ported: the kernel is
// sinc(x) * sinc(x/2) over |x| < 2, which is its definition, not a tuned
// approximation. FSR1's EASU is a *fast* Lanczos-2 -- its `fastLanczos2`
// is a polynomial that stands in for this -- so having the real thing
// beside it says what that approximation costs in quality and saves in
// time.
//
// Sixteen taps at 4x4, fetched as texels rather than through the
// bilinear filter: the weights are computed per tap, so there is nothing
// for the sampler's own interpolation to contribute and a point fetch is
// the cheaper of the two.
//
// The anti-ringing clamp is not optional in practice. Lanczos' negative
// lobes overshoot on hard edges -- which at a UI's text is every edge --
// and the usual fix is to bound the result by the nearest 2x2 it was
// built from. Without it this looks worse than bilinear on a menu.
//
// STUD_UPSCALER=lanczos.

precision mediump float;
precision highp int;

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform Params {
    ivec2 src_size;
    ivec2 dst_size;
    // How hard the anti-ringing clamp pulls: 0 leaves the overshoot
    // alone, 1 bounds it fully by the nearest 2x2. Stud's sharpness
    // setting arrives as 0.0-1.25 and is reused here rather than adding
    // a second control, since on this filter "sharper" and "let it ring"
    // are the same knob.
    float sharpness;
    int swap_rb;
} p;

const float kPi = 3.14159265358979323846;

// sinc(x) = sin(pi x) / (pi x), with the removable singularity at 0
// filled in.
float sinc(float x) {
    if (abs(x) < 1.0e-5) return 1.0;
    float pix = kPi * x;
    return sin(pix) / pix;
}

// Lanczos-2: the sinc, windowed by a second sinc stretched to the
// kernel's radius. Zero outside it.
float lanczos2(float x) {
    if (abs(x) >= 2.0) return 0.0;
    return sinc(x) * sinc(x * 0.5);
}

void main() {
    ivec2 out_pos = ivec2(gl_GlobalInvocationID.xy);
    if (out_pos.x >= p.dst_size.x || out_pos.y >= p.dst_size.y) return;

    highp vec2 src_size = vec2(p.src_size);
    highp vec2 uv = (vec2(out_pos) + 0.5) / vec2(p.dst_size);
    highp vec2 sample_pos = uv * src_size - 0.5;
    highp vec2 base = floor(sample_pos);
    vec2 f = vec2(sample_pos - base);

    ivec2 top_left = ivec2(base) - 1;
    ivec2 last = p.src_size - 1;

    // Separable, so the sixteen weights are four by four.
    float wx[4];
    float wy[4];
    for (int i = 0; i < 4; ++i) {
        wx[i] = lanczos2(float(i - 1) - f.x);
        wy[i] = lanczos2(float(i - 1) - f.y);
    }

    vec3 colour = vec3(0.0);
    float weight = 0.0;
    // The nearest 2x2, for the anti-ringing bound below. Those are taps
    // [1] and [2] on each axis.
    vec3 near_min = vec3(1.0);
    vec3 near_max = vec3(0.0);

    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            ivec2 at = clamp(top_left + ivec2(x, y), ivec2(0), last);
            vec3 texel = texelFetch(src, at, 0).rgb;
            float w = wx[x] * wy[y];
            colour += texel * w;
            weight += w;
            if (x >= 1 && x <= 2 && y >= 1 && y <= 2) {
                near_min = min(near_min, texel);
                near_max = max(near_max, texel);
            }
        }
    }
    colour /= max(weight, 1.0e-5);

    // Bound the overshoot by what the nearest neighbourhood actually
    // spans, mixed by how much ringing was asked for.
    float ring = clamp(1.0 - p.sharpness * 0.8, 0.0, 1.0);
    colour = mix(colour, clamp(colour, near_min, near_max), ring);
    colour = clamp(colour, 0.0, 1.0);

    // See upscale.comp: the last pass to write swizzles, so the
    // hand-over to the swapchain is a byte copy rather than a
    // converting blit.
    imageStore(dst, out_pos, vec4(p.swap_rb != 0 ? colour.bgr : colour, 1.0));
}
