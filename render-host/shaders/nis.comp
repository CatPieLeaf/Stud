#version 450
#extension GL_GOOGLE_include_directive : enable

// NVIDIA Image Scaling (NVScaler), as a third option beside FSR1 and SGSR.
//
//     Copyright(c) 2022 NVIDIA CORPORATION & AFFILIATES.
//     SPDX-License-Identifier: MIT
//
// The algorithm is the vendored header at
// third_party/nvidia-image-scaling/NIS/NIS_Scaler.h, included unmodified
// -- NVIDIA ship a GLSL path in it, so unlike SGSR there is nothing to
// port. This file is only the shell the header expects: it declares the
// names NIS_Scaler.h reaches for (samplerLinearClamp, in_texture,
// out_texture, coef_scaler, coef_usm, and the config scalars) and calls
// NVScaler.
//
// Two things differ from NVIDIA's own NIS_Main.glsl, and both are
// Stud's constraint rather than a change to the algorithm:
//
//   - The config arrives as push constants rather than a uniform buffer.
//     NISConfig is 28 scalars, 112 bytes, which fits inside the 128-byte
//     push-constant range every Vulkan implementation guarantees, and a
//     push saves a buffer and a descriptor per frame.
//
//   - No half-precision path. NIS_USE_HALF_PRECISION needs float16_t in
//     the SPIR-V, and that capability has to be matched by a device
//     feature the ENGINE enables at vkCreateDevice, not Stud -- Stud only
//     forwards that call. Asking for it here would be a pipeline that
//     fails to create on a device Stud cannot fix.
//
// Unlike EASU and SGSR, NVScaler's output cannot be pre-swizzled for the
// byte-copy hand-over: the store goes through the vendored header's own
// NVTEX_STORE. So a chain running NIS keeps the converting blit, and
// costs one full-resolution pass that the other two no longer pay. Worth
// remembering when reading its numbers against theirs.

#define NIS_GLSL 1
#define NIS_SCALER 1

// The names and the order are NISConfig's, which is memcpy'd straight in;
// see build_nis_compute(). An unnamed block puts the members at global
// scope, which is where NIS_Scaler.h expects to find them.
layout(push_constant) uniform const_buffer {
    float kDetectRatio;
    float kDetectThres;
    float kMinContrastRatio;
    float kRatioNorm;

    float kContrastBoost;
    float kEps;
    float kSharpStartY;
    float kSharpScaleY;

    float kSharpStrengthMin;
    float kSharpStrengthScale;
    float kSharpLimitMin;
    float kSharpLimitScale;

    float kScaleX;
    float kScaleY;

    float kDstNormX;
    float kDstNormY;
    float kSrcNormX;
    float kSrcNormY;

    uint kInputViewportOriginX;
    uint kInputViewportOriginY;
    uint kInputViewportWidth;
    uint kInputViewportHeight;

    uint kOutputViewportOriginX;
    uint kOutputViewportOriginY;
    uint kOutputViewportWidth;
    uint kOutputViewportHeight;

    float reserved0;
    float reserved1;
};

// A separate sampler and sampled images, which is what NIS_Scaler.h's
// GLSL macros build sampler2D() out of -- and the reason a NIS chain
// needs its own descriptor set layout rather than reusing the combined
// image sampler the other two upscalers share.
layout(set = 0, binding = 0) uniform sampler samplerLinearClamp;
layout(set = 0, binding = 1) uniform texture2D in_texture;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D out_texture;
layout(set = 0, binding = 3) uniform texture2D coef_scaler;
layout(set = 0, binding = 4) uniform texture2D coef_usm;

#include "NIS_Scaler.h"

layout(local_size_x = NIS_THREAD_GROUP_SIZE) in;

void main() {
    NVScaler(gl_WorkGroupID.xy, gl_LocalInvocationID.x);
}
