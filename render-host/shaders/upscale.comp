#version 450

// Catmull-Rom bicubic upscale.
//
// This replaced a hand-written EASU (FSR1's edge-adaptive resample). That
// attempt is worth recording as a negative result: EASU's weights are a
// specific pair of polynomials over the squared tap distance, and writing
// them from memory rather than from ffx_fsr1.h produced a kernel that was
// directionally wrong -- visibly scratched edges, blocky patches, and
// badly distorted text. A directional kernel with wrong weights is far
// worse than a good isotropic one.
//
// Catmull-Rom is the right trade here and is exactly specifiable: it is
// the interpolating cubic with continuous first derivatives, sharper than
// bilinear, and -- unlike Lanczos -- its overshoot is small enough that
// text and flat UI art survive it. Roblox's interface is mostly flat art
// and glyphs, which is the content that punishes an aggressive kernel
// hardest.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform Params {
    ivec2 src_size;
    ivec2 dst_size;
    float sharpness;  // not used here: sharpening is its own pass
} p;

// The Catmull-Rom basis, written out rather than factored, so it can be
// checked against the definition at a glance.
vec4 catmull_rom_weights(float t) {
    float t2 = t * t;
    float t3 = t2 * t;
    return vec4(-0.5 * t3 + t2 - 0.5 * t,
                 1.5 * t3 - 2.5 * t2 + 1.0,
                -1.5 * t3 + 2.0 * t2 + 0.5 * t,
                 0.5 * t3 - 0.5 * t2);
}

void main() {
    ivec2 out_pos = ivec2(gl_GlobalInvocationID.xy);
    if (out_pos.x >= p.dst_size.x || out_pos.y >= p.dst_size.y) return;

    vec2 scale = vec2(p.src_size) / vec2(p.dst_size);
    // Where this output pixel's centre falls in the source, in source
    // pixel centres.
    vec2 src_pos = (vec2(out_pos) + 0.5) * scale - 0.5;
    vec2 base = floor(src_pos);
    vec2 f = src_pos - base;

    vec4 wx = catmull_rom_weights(f.x);
    vec4 wy = catmull_rom_weights(f.y);

    vec2 inv = 1.0 / vec2(p.src_size);
    vec3 colour = vec3(0.0);
    // Separable, over the 4x4 neighbourhood. The sampler clamps at the
    // edges, so the rows and columns outside the image repeat rather than
    // wrap -- which is what keeps a border from smearing the far side in.
    for (int y = 0; y < 4; ++y) {
        vec3 row = vec3(0.0);
        for (int x = 0; x < 4; ++x) {
            vec2 tap = (base + vec2(float(x) - 1.0, float(y) - 1.0) + 0.5) * inv;
            row += texture(src, tap).rgb * wx[x];
        }
        colour += row * wy[y];
    }

    // Catmull-Rom's negative lobes can overshoot on a hard edge. Bounding
    // the result by the four pixels this sample sits between removes the
    // halo without softening anything that was not overshooting.
    vec3 c00 = texture(src, (base + vec2(0.5, 0.5)) * inv).rgb;
    vec3 c10 = texture(src, (base + vec2(1.5, 0.5)) * inv).rgb;
    vec3 c01 = texture(src, (base + vec2(0.5, 1.5)) * inv).rgb;
    vec3 c11 = texture(src, (base + vec2(1.5, 1.5)) * inv).rgb;
    vec3 lo = min(min(c00, c10), min(c01, c11));
    vec3 hi = max(max(c00, c10), max(c01, c11));

    imageStore(dst, out_pos, vec4(clamp(colour, lo, hi), 1.0));
}
