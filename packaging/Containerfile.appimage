# The image the AppImage is built in.
#
# Arch, because that is what quick-sharun (packaging/build-appimage.sh) is
# written against: it finds libraries, Qt plugins and drivers at Arch's
# paths, and its authors call building on anything else a bad idea. The
# AppImage carries every library it needs, glibc included, so the base's
# age is no floor on the machines that run it.
#
# A current Qt and KF6 Breeze come with it: a widget style can only load
# into the Qt it was built against, so the bundle has to carry its own.
FROM docker.io/library/archlinux:latest

RUN pacman -Syu --noconfirm --needed \
        base-devel cmake ninja git python curl unzip zstd e2fsprogs \
        pkgconf wayland-protocols vulkan-headers ffmpeg \
        qt6-base qt6-webengine qt6-wayland qtkeychain-qt6 breeze \
        vulkan-icd-loader libglvnd libx11 libxext libxi libxrender \
        freetype2 wayland libxkbcommon libxkbcommon-x11 libdecor \
        openssl libpulse alsa-lib \
        patchelf strace xorg-server-xvfb desktop-file-utils zsync wget \
    && pacman -Scc --noconfirm

WORKDIR /src
