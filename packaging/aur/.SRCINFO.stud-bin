pkgbase = stud-bin
	pkgdesc = An Unofficial Open-Source Roblox Launcher for Linux
	pkgver = 1.2.6
	pkgrel = 1
	url = https://github.com/CatPieLeaf/Stud
	arch = x86_64
	license = AGPL-3.0-or-later
	makedepends = cmake
	makedepends = ninja
	makedepends = git
	makedepends = vulkan-headers
	makedepends = wayland-protocols
	depends = bubblewrap
	depends = qt6-base
	depends = qt6-webengine
	depends = qtkeychain-qt6
	depends = vulkan-icd-loader
	depends = libglvnd
	depends = libdrm
	depends = libx11
	depends = libxext
	depends = libxi
	depends = freetype2
	depends = wayland
	depends = libxkbcommon
	depends = glibc
	depends = gcc-libs
	depends = openssl
	depends = hicolor-icon-theme
	optdepends = mangohud: the performance overlay Stud can switch on in Settings
	optdepends = wl-clipboard: copying a server link from the tray menu on Wayland
	optdepends = libdecor: a titlebar on a Wayland compositor that draws none itself, such as GNOME
	optdepends = libxkbcommon-x11: the exact keyboard layout under X11 (loaded at runtime)
	optdepends = ffmpeg: video playback and screen recording inside games (loaded at runtime)
	provides = stud=1.2.6
	conflicts = stud
	options = !strip
	options = !debug
	options = emptydirs
