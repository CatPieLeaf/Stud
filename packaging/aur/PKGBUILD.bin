# Maintainer: CatPieLeaf <catpieleaf@proton.me>
#
# Not for the AUR. This is what CI uses to turn an already-built install
# tree into a pkg.tar.zst, so Arch users can install Stud without
# building it from source.
#
# It builds nothing: `package()` copies a DESTDIR that cmake --install has
# already produced. CI sets STUD_DESTDIR to it.

pkgname=stud
pkgver=1.2.14
pkgrel=1
pkgdesc="An Unofficial Open-Source Roblox Launcher for Linux"
arch=('x86_64')
url="https://github.com/CatPieLeaf/Stud"
license=('AGPL-3.0-or-later' 'GPL-3.0-only' 'LGPL-3.0-or-later' 'MIT' 'BSD-3-Clause')
# The same list as the source PKGBUILD, and it has to stay that way: a
# dependency that only one of them names is a broken package for half the
# people who install it.
depends=(
  'qt6-base'
  'qt6-webengine'
  'qt6-webchannel'
  'sdl3'
  'vulkan-icd-loader'
  'curl'
  'zlib'
  'libxkbcommon'
  'systemd-libs'
  'glibc'
  'gcc-libs'
  'hicolor-icon-theme'
  'ffmpeg'
)
optdepends=(
  'gamemode: the CPU in its performance mode while Roblox runs'
  'mangohud: the performance overlay Stud can switch on in Settings'
)
options=(!debug emptydirs)

package() {
  cp -a "${STUD_DESTDIR:?set STUD_DESTDIR to the install tree}"/. "$pkgdir"/

  # Arch does not use /usr/libexec, a package's own executables belong
  # in /usr/lib/<pkg>/, and namcap reports anything under libexec as
  # misplaced. stud-ui looks for Rosemary in both, so the binaries need
  # no rebuild for this.
  if [ -d "$pkgdir/usr/libexec/stud" ]; then
    mkdir -p "$pkgdir/usr/lib"
    cp -a "$pkgdir/usr/libexec/stud" "$pkgdir/usr/lib/stud-helpers"
    cp -a "$pkgdir/usr/lib/stud-helpers/." "$pkgdir/usr/lib/stud/"
    rm -rf "$pkgdir/usr/lib/stud-helpers" "$pkgdir/usr/libexec"
  fi
}
