# Maintainer: CatPieLeaf <catpieleaf@proton.me>
#
# Builds Stud from the release source.
#
# NOT THE PACKAGE PUBLISHED TO THE AUR; `stud-bin` is (PKGBUILD.stud-bin
# beside this file). prepare() below runs tools/setup.sh, which downloads
# Google's NDK, an ANGLE checkout and a bionic image from AOSP. makepkg
# only fetches what is listed in source=(), and a clean chroot has no
# network once the build starts, so this PKGBUILD cannot build there.
#
# That is not an oversight that can be tidied away: ANGLE's own build runs
# `gclient sync`, which pulls dozens of dependencies as it goes, and there
# is no self-contained ANGLE source tarball to list in source=() instead.
# Stud needs both its Vulkan and its SwiftShader backends, which no
# distribution ships, so it is built rather than depended on.
#
# It is kept here, and kept working, for building Stud from source on your
# own machine, `makepkg -si` in this directory does exactly that. Expect
# around an hour, almost all of it ANGLE, and around 15 GB of scratch
# space.

pkgname=stud
pkgver=1.1.6
pkgrel=1
pkgdesc="An Unofficial Open-Source Roblox Launcher for Linux"
arch=('x86_64')
url="https://github.com/CatPieLeaf/Stud"
license=('AGPL-3.0-or-later')
# bubblewrap is not optional: Process B is launched inside it, and Stud
# refuses to start without it. It is a package rather than a bundled
# binary on purpose, a distribution's own build carries the AppArmor and
# SELinux policy that lets it create a user namespace at all.
#
# Audio is not listed: miniaudio is compiled into render-host and opens
# whichever of libasound, libpulse or libjack the machine has, by name at
# runtime, so there is no package to depend on.
depends=(
  'bubblewrap'
  'qt6-base'
  'qt6-webengine'
  'qtkeychain-qt6'
  'vulkan-icd-loader'
  'libglvnd'
  'libx11'
  'libxext'
  'libxi'
  'freetype2'
  'wayland'
  'libxkbcommon'
  'glibc'
  'gcc-libs'
  'openssl'
  'hicolor-icon-theme'
)
makedepends=(
  'cmake'
  'ninja'
  'git'
  'python'
  'curl'
  'unzip'
  'zstd'
  'e2fsprogs'
  'wayland-protocols'
  'vulkan-headers'
  'pkgconf'
)
optdepends=(
  'mangohud: the performance overlay Stud can switch on in Settings'
  'wl-clipboard: copying a server link from the tray menu on Wayland'
  'libdecor: a titlebar on a Wayland compositor that draws none itself, such as GNOME'
)
# The tag carries no leading "v", match what is actually published.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
# Replaced by CI at release time, from the tarball GitHub actually serves.
sha256sums=('9700184f8f2b0371f7b2898bc2acd77cfc9018c7de96210ef5952e6efaed10f6')

prepare() {
  cd "Stud-$pkgver"
  # The NDK, ANGLE and bionic. This is the long part, and it is skipped
  # for anything already present, so an interrupted build resumes
  # rather than starting over.
  tools/setup.sh
}

build() {
  cd "Stud-$pkgver"
  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DSTUD_VERSION="$pkgver"
  cmake --build build
}

check() {
  cd "Stud-$pkgver"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "Stud-$pkgver"
  DESTDIR="$pkgdir" cmake --install build

  # Arch does not use /usr/libexec, a package's own executables belong
  # in /usr/lib/<pkg>/, and namcap reports anything under libexec as
  # misplaced (12 errors on this package before this moved). stud-ui
  # probes both layouts, so the binaries need no rebuild for this.
  if [ -d "$pkgdir/usr/libexec/stud" ]; then
    mkdir -p "$pkgdir/usr/lib"
    cp -a "$pkgdir/usr/libexec/stud" "$pkgdir/usr/lib/stud-helpers"
    cp -a "$pkgdir/usr/lib/stud-helpers/." "$pkgdir/usr/lib/stud/"
    rm -rf "$pkgdir/usr/lib/stud-helpers" "$pkgdir/usr/libexec"
  fi
}
