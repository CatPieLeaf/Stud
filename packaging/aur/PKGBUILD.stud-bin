# Maintainer: CatPieLeaf <catpieleaf@proton.me>
#
# The mostly-prebuilt package. It installs the release archive CI built
# from the tag, so no ANGLE build, and no network beyond the two files
# makepkg fetches itself before build() runs, and compiles ONLY the two
# executables that link Qt.
#
# Those two cannot be shipped prebuilt. A Qt program built against one
# distribution's Qt does not run on another's, and this archive is built
# on Fedora: installed as-is on Arch, /usr/bin/stud dies at the loader
# with `copy relocation against non-copyable protected symbol
# QLocalServer::staticMetaObject ... GNU_PROPERTY_1_NEEDED_INDIRECT_
# EXTERN_ACCESS`, because Arch builds Qt with indirect external access.
# Measured, not assumed. Nothing else in the archive has that problem:
# render-host, Process B, ANGLE and the bionic set link no Qt at all.
#
# So STUD_BUILD_QT_ONLY rebuilds `stud` and `stud-webview` here, against
# the Qt this machine has, exactly as the Flatpak and the release
# workflow's own Arch package do.
#
# This is the one that belongs in the AUR. The source PKGBUILD beside it
# fetches Google's NDK, an ANGLE checkout and a bionic image from inside
# prepare(), and makepkg only downloads what is in source=(): in a clean
# chroot there is no network at that point, so it cannot build there.
# packaging/aur/README.md has the whole of that reasoning.

pkgname=stud-bin
_pkgname=stud
pkgver=1.1.1
pkgrel=1
pkgdesc="Play Roblox on Linux, runs the real, unmodified Roblox Android app"
arch=('x86_64')
url="https://github.com/CatPieLeaf/Stud"
license=('AGPL-3.0-or-later')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
# The same list as the source PKGBUILD, and it has to stay that way: a
# dependency that only one of them names is a broken package for half the
# people who install it.
depends=(
  'bubblewrap'
  'qt6-base'
  'qt6-webengine'
  'qtkeychain-qt6'
  'vulkan-icd-loader'
  'libglvnd'
  'libxext'
  'portaudio'
  'freetype2'
  'wayland'
  'libxkbcommon'
  'glibc'
  'gcc-libs'
  'openssl'
  'hicolor-icon-theme'
)
optdepends=(
  'mangohud: the performance overlay Stud can switch on in Settings'
  'wl-clipboard: copying a server link from the tray menu on Wayland'
)
# Stripping a bionic ELF or ANGLE is neither useful nor safe, the same
# reason the rpm turns it off. These are also already-built binaries, so
# there is nothing here for makepkg to strip that upstream did not mean.
options=(!strip !debug emptydirs)
makedepends=(
  'cmake'
  'ninja'
  'git'
  'vulkan-headers'
  'wayland-protocols'
)
# The tag carries no leading "v", match what is actually published. The
# source tarball is here for the Qt half above, not for a full build.
source=("$pkgname-$pkgver.tar.zst::$url/releases/download/$pkgver/stud-$pkgver-$CARCH.tar.zst"
        "$_pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
# Filled in at publish time from the archive the release actually
# serves, `updpkgsums`, or the value the release workflow prints at the
# end of its run. A checksum belongs to one specific archive, so a stale
# one is worse than an obvious gap: this carried the digest of a release
# that was later deleted, which would have failed every install with a
# corruption error rather than a missing-file one.
sha256sums=('052ae69bdbe2519f77f2be6eb743980bdd20b44c4aa7fe224506fe290019fa49'
            '5edc5ebb87dc70618fe56858e9fa67a026959d21110056263533d8cd910863ce')

build() {
  # Just the Qt half: STUD_BUILD_QT_ONLY skips the render host, the
  # bionic runtime and ANGLE, which the archive already supplies.
  cmake -S "Stud-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DSTUD_BUILD_QT_ONLY=ON \
    -DSTUD_BUILD_TESTS=OFF \
    -DSTUD_VERSION="$pkgver"
  cmake --build build
}

package() {
  # The archive is the install tree rooted at usr/, which is exactly what
  # a package is. Nothing is rebuilt, only relocated below.
  cp -a usr "$pkgdir"/

  # Arch does not use /usr/libexec, a package's own executables belong
  # in /usr/lib/<pkg>/, and namcap reports anything under libexec as
  # misplaced (12 errors on this package before this moved). stud-ui
  # probes both layouts, so the binaries need no rebuild for this.
  if [ -d "$pkgdir/usr/libexec/stud" ]; then
    mkdir -p "$pkgdir/usr/lib"
    cp -a "$pkgdir/usr/libexec/stud" "$pkgdir/usr/lib/stud-helpers"
    cp -a "$pkgdir/usr/lib/stud-helpers/." "$pkgdir/usr/lib/stud/"
    rm -rf "$pkgdir/usr/lib/stud-helpers" "$pkgdir/usr/libexec"
  fi

  # ...and the two Qt executables built above replace the archive's own,
  # which were compiled against a different distribution's Qt. See the
  # header for what happens without this.
  install -Dm755 build/ui/stud-ui "$pkgdir/usr/bin/stud"
  install -Dm755 build/webview/stud-webview "$pkgdir/usr/lib/stud/stud-webview"
}
