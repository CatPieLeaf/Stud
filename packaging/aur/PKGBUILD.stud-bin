# Maintainer: CatPieLeaf <catpieleaf@proton.me>
#
# The package published to the AUR. Installs the release archive and rebuilds only
# the launcher against Arch's Qt: Arch builds Qt with indirect external access, so a
# launcher linked against Fedora's Qt fails with a copy relocation error. Rosemary
# links no Qt and is used as shipped. See packaging/aur/README.md.

pkgname=stud-bin
_pkgname=stud
pkgver=2.0.3
pkgrel=1
pkgdesc="Play and create games on Roblox"
arch=('x86_64')
url="https://github.com/CatPieLeaf/Stud"
license=('AGPL-3.0-or-later')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
# Must match the source PKGBUILD's list.
depends=(
  'gamemode'
  'qt6-base'
  'qt6-webengine'
  'qt6-webchannel'
  'sdl3'
  'vulkan-icd-loader'
  'curl'
  'openssl'
  'libsecret'
  'zlib'
  'libxkbcommon'
  'systemd-libs'
  'glibc'
  'gcc-libs'
  'hicolor-icon-theme'
  'ffmpeg'
)
optdepends=(
  'mangohud: the performance overlay Stud can switch on in Settings'
)
# Prebuilt binaries keep their symbols.
options=(!strip !debug emptydirs)
makedepends=(
  'cmake'
  'ninja'
  'git'
  'vulkan-headers'
)
# The source tarball is only for building the launcher.
source=("$pkgname-$pkgver.tar.zst::$url/releases/download/$pkgver/stud-$pkgver-$CARCH.tar.zst"
        "$_pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
# Filled in at release time (updpkgsums or the release workflow's output).
sha256sums=('545f43641c591bb6855cce9c3e8d14e1c53cb17a6943be07947d21a8ce640c94'
            'f5402fd159f9dbd1b2f2c6d2ce472c1134a5b4b42d64a58b9c76ed0601f181d1')

build() {
  # Only the launcher; Rosemary comes from the archive.
  cmake -S "Stud-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DSTUD_BUILD_ROSEMARY=OFF \
    -DSTUD_BUILD_TESTS=OFF \
    -DSTUD_VERSION="$pkgver"
  cmake --build build
}

package() {
  # The archive is the install tree rooted at usr/.
  cp -a usr "$pkgdir"/

  # Arch has no /usr/libexec; stud-ui looks for Rosemary in lib/stud too.
  if [ -d "$pkgdir/usr/libexec/stud" ]; then
    mkdir -p "$pkgdir/usr/lib"
    cp -a "$pkgdir/usr/libexec/stud" "$pkgdir/usr/lib/stud-helpers"
    cp -a "$pkgdir/usr/lib/stud-helpers/." "$pkgdir/usr/lib/stud/"
    rm -rf "$pkgdir/usr/lib/stud-helpers" "$pkgdir/usr/libexec"
  fi

  # Replace the archive's launcher, built against Fedora's Qt.
  install -Dm755 build/ui/stud-ui "$pkgdir/usr/bin/stud"
}
