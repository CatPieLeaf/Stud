# The OCI image cpak installs Stud from.
#
# cpak does not build anything itself: it installs an application out of
# an OCI image and runs it in a rootless sandbox. So this image is just
# an ordinary Fedora root filesystem with Stud installed into /usr and
# Stud's own runtime dependencies present.
#
# Built in two stages so the published image carries none of the build
# toolchain, the compiler, the NDK and the ANGLE checkout together are
# several gigabytes and none of it is needed to run.
#
# The build context must already have third_party/ populated
# (tools/setup.sh), the same as any other build of Stud. It is not
# fetched here: ANGLE builds from source and takes hours, which does not
# belong inside an image build that is otherwise minutes.

FROM fedora:44 AS build

RUN dnf install -y --setopt=install_weak_deps=False \
        gcc-c++ cmake ninja-build git pkgconf-pkg-config \
        qt6-qtbase-devel qt6-qtwebengine-devel qtkeychain-qt6-devel \
        wayland-devel wayland-protocols-devel libxkbcommon-devel \
        mesa-libEGL-devel mesa-libGLES-devel vulkan-loader-devel \
        freetype-devel portaudio-devel openssl-devel \
    && dnf clean all

COPY . /src
RUN cmake -S /src -B /build -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    && cmake --build /build -j"$(nproc)" \
    && DESTDIR=/stage cmake --install /build --prefix /usr

FROM fedora:44

# bubblewrap is a real runtime dependency, not a packaging detail:
# Process B is a bionic ELF that runs inside its own mount, PID and IPC
# namespaces, and Stud creates them with bwrap. cpak's own sandbox does
# not replace it, the manifest grants userNamespaces so this one can
# nest inside it.
RUN dnf install -y --setopt=install_weak_deps=False \
        bubblewrap \
        qt6-qtbase-gui qt6-qtwebengine qtkeychain-qt6 \
        vulkan-loader mesa-vulkan-drivers mesa-libEGL mesa-libGLES \
        portaudio freetype \
        alsa-plugins-pulseaudio \
        dbus-libs libnotify \
        wl-clipboard \
        plasma-breeze-qt6 \
    && dnf clean all

# ALSA needs telling where the sound goes.
#
# Fedora's PortAudio is built with the ALSA and JACK backends only, so it
# never talks to PulseAudio directly; the sandbox has no /dev/snd and only
# the sound server's socket, so ALSA found no device at all and every
# stream opened silent ("could not open a device (Device unavailable)"),
# with nothing appearing in the volume mixer. alsa-plugins-pulseaudio
# above supplies the pcm, and this points the default at it.
RUN printf 'pcm.!default { type pulse }\nctl.!default { type pulse }\n' > /etc/asound.conf

# What the application looks like, and where its file dialog can reach.
#
# Both were wrong in the first image that anyone ran: Stud came up in bare
# Qt colours instead of the desktop's, and the APK picker could only see
# Downloads, because Qt used its own dialog and its own default palette.
#
# The portal platform theme fixes both at once; it takes colours, fonts
# and icons from the host through the portal, and routes QFileDialog to
# the portal's file chooser, which is what lets the user pick an APK from
# anywhere without the sandbox mounting their home. The plugin is already
# in the image (qt6-qtbase-gui ships it); nothing was selecting it.
#
# plasma-breeze-qt6 above is the real Breeze widget style, for the same
# reason the AppImage carries one: a widget style is a Qt plugin and can
# only load into the Qt it was built against, so the host's own cannot be
# used from in here.
ENV QT_QPA_PLATFORMTHEME=xdgdesktopportal

COPY --from=build /stage/usr /usr

LABEL org.opencontainers.image.title="Stud" \
      org.opencontainers.image.description="An Unofficial Open-Source Roblox Launcher for Linux" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/CatPieLeaf/Stud"
