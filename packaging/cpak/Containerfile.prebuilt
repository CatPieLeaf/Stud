# The same image as Containerfile, assembled from an install tree that
# already exists rather than building one.
#
# CI produces exactly one build of Stud and wraps it as an rpm, a deb, an
# Arch package, an AppImage and a Flatpak archive. Building the cpak image
# from source as well would mean a second build, and, worse, no
# guarantee that the image holds the same binaries as every
# other package from that release.
#
# Expects install-tree/usr next to it, which is what
# `DESTDIR=install-tree cmake --install build` writes.

FROM fedora:44

# What the launcher and Rosemary need at run time. SDL3, the Vulkan loader
# and FFmpeg are opened by name, so nothing would pull them in by itself.
RUN dnf install -y --setopt=install_weak_deps=False \
        qt6-qtbase-gui qt6-qtwebengine qt6-qtwebchannel \
        SDL3 vulkan-loader mesa-vulkan-drivers mesa-libEGL mesa-libgbm \
        libcurl zlib libxkbcommon libxkbcommon-x11 systemd-libs \
        libX11 libXext libdecor \
        pipewire-libs pulseaudio-libs alsa-lib \
        libavcodec-free libavutil-free \
        dbus-libs libnotify wl-clipboard \
        plasma-breeze-qt6 \
    && dnf clean all

# What the application looks like, and where its file dialog can reach.
#
# Both were wrong in the first image anyone ran: Stud came up in bare Qt
# colours instead of the desktop's, and its file picker could only see
# Downloads, because Qt used its own dialog and its own default palette.
#
# The portal platform theme fixes both at once. It takes colours, fonts
# and icons from the host through the portal, and routes QFileDialog to
# the portal's file chooser, which lets the user pick a file from anywhere
# without the sandbox mounting their home. qt6-qtbase-gui already ships
# the plugin; nothing was selecting it.
#
# plasma-breeze-qt6 above is the real Breeze widget style, for the same
# reason the AppImage carries one: a widget style is a Qt plugin and can
# only load into the Qt it was built against, so the host's own cannot be
# used from in here.
#
# This runtime layer is kept identical to the one in Containerfile, and
# tools/check-cpak-runtime.py fails the build when they drift. CI builds
# only this file, so anything added to the other one reaches nobody.
ENV QT_QPA_PLATFORMTHEME=xdgdesktopportal

COPY install-tree/usr /usr

LABEL org.opencontainers.image.title="Stud" \
      org.opencontainers.image.description="An Unofficial Open-Source Roblox Launcher for Linux" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/CatPieLeaf/Stud"
