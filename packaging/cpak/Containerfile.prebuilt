# The same image as Containerfile, assembled from an install tree that
# already exists rather than building one.
#
# CI produces exactly one build of Stud and wraps it as an rpm, a deb, an
# Arch package, an AppImage and a Flatpak archive. Building the cpak image
# from source as well would mean a second compile of ANGLE, an hour:
# and, worse, no guarantee that the image holds the same binaries as every
# other package from that release.
#
# Expects install-tree/usr next to it, which is what
# `DESTDIR=install-tree cmake --install build` writes.

FROM fedora:44

# bubblewrap is a real runtime dependency, not a packaging detail:
# Process B is a bionic ELF that runs inside its own mount, PID and IPC
# namespaces, and Stud creates them with bwrap. cpak's own sandbox does
# not replace it, the manifest grants userNamespaces so this one can
# nest inside it.
RUN dnf install -y --setopt=install_weak_deps=False \
        bubblewrap \
        qt6-qtbase-gui qt6-qtwebengine qtkeychain-qt6 \
        vulkan-loader mesa-vulkan-drivers mesa-libEGL mesa-libGLES \
        portaudio freetype \
        dbus-libs libnotify \
    && dnf clean all

COPY install-tree/usr /usr

LABEL org.opencontainers.image.title="Stud" \
      org.opencontainers.image.description="Play Roblox on Linux" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/CatPieLeaf/Stud"
