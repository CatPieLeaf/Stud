[Desktop Entry]
Type=Application
Name=Stud
Comment=Unofficial Roblox launcher for Linux
# Exec is filled in at configure time: the plain command for an
# installed package, an absolute path for a build tree.
Exec=@STUD_EXEC@ %u
Icon=@STUD_APP_ID@
Terminal=false
# Without this the launcher mints no activation token, and a Stud that is
# already running cannot be brought forward when a game link is clicked:
# Wayland lets no application raise itself, so the ONLY thing that can do
# it is a token from the process the user acted in. The portal passes that
# token to the handler it spawns in XDG_ACTIVATION_TOKEN, but only when
# the entry asks for startup notification. Live-caught: the link arrived
# and the game joined, with the window still behind the browser.
StartupNotify=true
Categories=Game;
NoDisplay=false
MimeType=x-scheme-handler/roblox-player;x-scheme-handler/roblox;
# Both of Stud's windows report the application id as their Wayland
# app_id: the Qt UI through QGuiApplication::setDesktopFileName(), and the
# game window through xdg_toplevel_set_app_id(). Without a StartupWMClass
# that matches, the compositor cannot tie either window back to this entry,
# which is why the taskbar showed no icon even once the icon was installed.
StartupWMClass=@STUD_APP_ID@
Actions=Settings;

[Desktop Action Settings]
Name=Settings
Exec=@STUD_EXEC@ --settings
Icon=@STUD_APP_ID@
