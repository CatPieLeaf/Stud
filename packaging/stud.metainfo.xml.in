<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@STUD_APP_ID@</id>
  <launchable type="desktop-id">@STUD_APP_ID@.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <name>Stud</name>
  <summary>An Unofficial Open-Source Roblox Launcher for Linux</summary>

  <description>
    <p>
      Stud runs the real, unmodified Roblox app on your Linux desktop, in its
      own window, with your mouse and keyboard. No browser, no emulator, no
      virtual machine.
    </p>
    <p>Features:</p>
    <ul>
      <li>Links from your browser open straight into the experience</li>
      <li>Mouse and keyboard behave the way they do in the desktop client</li>
      <li>Upscaling, so the game can render below your screen's resolution and still fill it</li>
      <li>Discord Rich Presence, with a button friends can join through</li>
      <li>A system tray menu, and the country a server is in when you join</li>
    </ul>
    <p>
      Roblox is not included. You supply the Android application package
      yourself, and Roblox remains subject to its own terms.
    </p>
    <p>
      Stud is an independent project and is not affiliated with, endorsed by
      or approved by Roblox Corporation.
    </p>
  </description>

  <categories>
    <category>Game</category>
  </categories>

  <keywords>
    <keyword>Roblox</keyword>
    <keyword>games</keyword>
  </keywords>

  <!--
    Screenshots are fetched over the network by every store that shows
    them, so they have to be URLs: a path to a file inside this package
    is not something Discover or GNOME Software can read. They are served
    from this repository itself, which means they resolve once main is
    pushed; the files are in packaging/screenshots/.

    The first one is the default: it is what a store lists the
    application by.
  -->
  <screenshots>
    <screenshot type="default">
      <caption>The Roblox home screen, running on a Linux desktop</caption>
      <image type="source" width="1013" height="783">https://raw.githubusercontent.com/CatPieLeaf/Stud/main/packaging/screenshots/home.png</image>
    </screenshot>
    <screenshot>
      <caption>An experience in progress</caption>
      <image type="source" width="1013" height="783">https://raw.githubusercontent.com/CatPieLeaf/Stud/main/packaging/screenshots/game1.png</image>
    </screenshot>
    <screenshot>
      <caption>An experience in progress</caption>
      <image type="source" width="1013" height="783">https://raw.githubusercontent.com/CatPieLeaf/Stud/main/packaging/screenshots/game2.png</image>
    </screenshot>
    <screenshot>
      <caption>An experience in progress</caption>
      <image type="source" width="1013" height="783">https://raw.githubusercontent.com/CatPieLeaf/Stud/main/packaging/screenshots/game3.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/CatPieLeaf/Stud</url>
  <url type="bugtracker">https://github.com/CatPieLeaf/Stud/issues</url>
  <url type="vcs-browser">https://github.com/CatPieLeaf/Stud</url>

  <developer id="io.github.catpieleaf">
    <name>CatPieLeaf</name>
  </developer>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-info">moderate</content_attribute>
    <content_attribute id="money-purchasing">intense</content_attribute>
    <content_attribute id="violence-cartoon">moderate</content_attribute>
  </content_rating>

  <releases>
    <release version="@STUD_VERSION@" date="2026-09-17">
      <description>
        <p>X11 sessions, and the frame that stopped waiting on itself.</p>
        <ul>
          <li>Resizing or maximising a window on X11 no longer kills the
              game. A rebuild was being asked for a size the window had
              already left, which the driver spent twenty-two seconds
              refusing.</li>
          <li>The strip of desktop that showed through a window while it
              was being resized is gone.</li>
          <li>HiDPI on X11 rendered one pixel past the window it was
              presenting to, which left the screen black.</li>
          <li>A swapchain is no longer destroyed while the sharpening pass
              is still writing into it, which is one way a session could
              freeze for twelve seconds and recover on its own.</li>
          <li>Nothing asks the driver about a window while a swapchain is
              being built for it.</li>
          <li>What the engine writes into mapped memory no longer crosses
              a socket to reach the renderer: both processes share the
              same pages, and only the parts that changed are named. The
              kernel tracks which those are, so the engine is never
              interrupted to find out.</li>
          <li>One thread now owns the connection to the renderer. Work
              that needs no answer is queued and left alone, so the
              engine's own thread stops waiting to be told a queue is
              empty.</li>
        </ul>
      </description>
    </release>

    <release version="1.1.3" date="2026-09-16">
      <description>
        <p>Keyboards that are not American, and a handful of things that
           only went wrong at the edges.</p>
        <ul>
          <li>A key now keeps its own position when the layout cannot reach
              that character any other way, so the apostrophe key on a
              Brazilian keyboard opens the inventory again.</li>
          <li>A key held while chat takes focus still types. It is withheld
              from the game, not from the chat box.</li>
          <li>Leaving first person keeps the cursor in the middle of the
              window instead of returning it to wherever the hand was.</li>
          <li>Closing Stud no longer leaves a crash report behind: a fault
              during teardown is the teardown, and an inner call can no
              longer strip the crash protection from the thread around
              it.</li>
          <li>Writes to memory the engine has mapped are tracked by the
              kernel where it can, and the flush that ships them no longer
              drops any.</li>
          <li>The Debian package is built against the oldest Qt it claims
              to support, so it runs on Ubuntu 24.04, Debian 13 and the
              Mint releases built on them.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-12">
      <description>
        <p>First packaged release.</p>
      </description>
    </release>
  </releases>
</component>
