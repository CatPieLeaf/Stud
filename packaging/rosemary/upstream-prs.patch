+    ) -> Id {
+        let object = fake(classes().0, pixel_format, width, height);
+        objc::arc::autorelease(object)
+    }
+
+    unsafe extern "C" fn make_texture(_device: Id, _sel: Sel, descriptor: Id) -> Id {
+        let d = body(descriptor);
